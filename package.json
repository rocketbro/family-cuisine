{
  "name": "cuisine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:server": "PORT=2848 node --env-file-if-exists=.env --watch src/server/main.ts",
    "start": "node --env-file-if-exists=.env src/server/main.ts",
    "test": "vitest run --dir src",
    "typecheck": "tsc -b",
    "check": "npm run typecheck && npm run lint && npm test",
    "icons": "node scripts/icons.ts",
    "setup": "node scripts/setup.ts",
    "service": "scripts/install-service.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "better-sqlite3": "^13.0.3",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.16",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "sherpa-onnx-node": "^2.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
