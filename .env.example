# Copy to .env (`npm run setup` does that and writes the VAPID keys). Everything here is optional;
# the app runs with none of it. The README explains each one. Restart after editing.

# ANTHROPIC_API_KEY=
# UNSPLASH_ACCESS_KEY=

# Notifications. `npm run setup` fills these in.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# PORT=2847
# The HTTPS address your phones use, from `tailscale serve`:
# PUBLIC_URL=https://your-machine.your-tailnet.ts.net

# Who this server answers to, and who gets in. The README's Security section explains these.
# Web push contact, a mailto: or https: address. Only needed if PUBLIC_URL isn't https.
# VAPID_SUBJECT=mailto:you@example.com
# More names this server answers to, comma separated. Loopback and PUBLIC_URL's host always work.
# ALLOWED_HOSTS=cuisine.example.com
# A shared password of 16 or more characters, for anything beyond a private network.
# ACCESS_TOKEN=
# HOST defaults to 127.0.0.1. Any other address refuses to start without ACCESS_TOKEN, unless
# ALLOW_OPEN_NETWORK is set too, which means everyone who can reach the port has full access.
# HOST=0.0.0.0
# ALLOW_OPEN_NETWORK=1

# Where data lives. `~` works here. The default is ~/Library/Application Support/Cuisine on macOS
# and ~/.local/share/cuisine on Linux. ./data is ignored by git, if you'd like it in the checkout.
# CUISINE_DATA_DIR=./data

# Aldi and Walmart lookups: off unless set to on. Read that section of the README first.
# ALDI_PRICE_LOOKUP=on
# WALMART_PRODUCT_LOOKUP=on

# Dictation (all optional; see the README).
# FFMPEG=/path/to/ffmpeg
# PARAKEET_DIR=~/models/sherpa-onnx-nemo-parakeet-tdt-0.6b-v3-int8
# FLUIDVOICE_URL=http://127.0.0.1:47733

# Schedule. Weekdays count from 0 = Sunday, times are 24-hour.
# PLAN_TIME=08:00
# CHECKIN_TIME=19:45
# First-run default; Settings takes over once someone picks a day:
# SHOP_WEEKDAY=3
# First-run default; Settings takes over once saved there:
# DINNER_TIME=6:30 PM
# First-run default; Settings takes over once saved there:
# NIGHT_BEFORE_TIME=17:00

# The Claude model:
# CUISINE_MODEL=claude-sonnet-5-5
# The faster, cheaper one for recipe imports, night-before steps and fetching blocked pages:
# CUISINE_FAST_MODEL=claude-haiku-5-5
# The macOS LaunchAgent's name (`npm run service`):
# CUISINE_SERVICE_LABEL=local.cuisine
